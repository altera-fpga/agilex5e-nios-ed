FUNCTION altera_syncram_impl_mib71 (address_a[5..0], address_b[5..0], addressstall_b, clock0, data_a[31..0], data_b[31..0], rden_a, wren_a)
RETURNS ( q_b[31..0]);

--synthesis_resources = ram_bits (AUTO) 2048 
SUBDESIGN altsyncram_ejmg1
( 
	address_a[5..0]	:	input;
	address_b[5..0]	:	input;
	addressstall_b	:	input;
	clock0	:	input;
	data_a[31..0]	:	input;
	data_b[31..0]	:	input;
	q_b[31..0]	:	output;
	rden_a	:	input;
	wren_a	:	input;
) 
VARIABLE 
	altera_syncram_impl1 : altera_syncram_impl_mib71;

BEGIN 
	altera_syncram_impl1.address_a[] = address_a[];
	altera_syncram_impl1.address_b[] = address_b[];
	altera_syncram_impl1.addressstall_b = addressstall_b;
	altera_syncram_impl1.clock0 = clock0;
	altera_syncram_impl1.data_a[] = data_a[];
	altera_syncram_impl1.data_b[] = data_b[];
	altera_syncram_impl1.rden_a = rden_a;
	altera_syncram_impl1.wren_a = wren_a;
	q_b[] = altera_syncram_impl1.q_b[];
END;
