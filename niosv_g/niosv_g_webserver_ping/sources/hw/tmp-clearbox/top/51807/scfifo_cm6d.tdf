FUNCTION a_dpfifo_v9oc1 (clock, data[41..0], rreq, sclr, wreq)
RETURNS ( empty, full, q[41..0], usedw[10..0]);

--synthesis_resources = altera_counter 3 ram_bits (AUTO) 86016 reg 19 
SUBDESIGN scfifo_cm6d
( 
	clock	:	input;
	data[41..0]	:	input;
	empty	:	output;
	full	:	output;
	q[41..0]	:	output;
	rdreq	:	input;
	sclr	:	input;
	usedw[10..0]	:	output;
	wrreq	:	input;
) 
VARIABLE 
	dpfifo : a_dpfifo_v9oc1;

BEGIN 
	dpfifo.clock = clock;
	dpfifo.data[] = data[];
	dpfifo.rreq = rdreq;
	dpfifo.sclr = sclr;
	dpfifo.wreq = wrreq;
	empty = dpfifo.empty;
	full = dpfifo.full;
	q[] = dpfifo.q[];
	usedw[] = dpfifo.usedw[];
END;
